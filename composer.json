{
	"name": "jcdhan1/dtlr",
	"type": "project",
	"description": "Digital Techniques for Language Revival - Research project information, multilingual dictionary and machine translation UI.",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": "8.4.*",
		"guzzlehttp/guzzle": "7.10.*",
		"laravel/framework": "10.50.*",
		"laravel/sanctum": "v3.3.*",
		"laravel/tinker": "v2.11.*",
		"spatie/laravel-db-snapshots": "^2.7",
		"toobo/bcp47": "^1"
	},
	"require-dev": {
		"fakerphp/faker": "v1.24.*",
		"laravel/breeze": "^1.29",
		"laravel/pint": "v1.20.*",
		"laravel/sail": "v1.53.*",
		"mockery/mockery": "1.6.*",
		"nunomaduro/collision": "v7.12.*",
		"phpunit/phpunit": "10.5.*",
		"spatie/laravel-ignition": "2.9.*"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi"
		],
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi --force"
		],
		"post-root-package-install": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
		],
		"post-create-project-cmd": [
			"@php artisan key:generate --ansi"
		]
	},
	"extra": {
		"laravel": {
			"dont-discover": []
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		},
		"policy": {
			"advisories": {
				"ignore": [
					"PKSA-gcrk-3vtt-1r14",
					"PKSA-cnw1-2ytm-cgr8",
					"PKSA-fy2t-3c5f-827y",
					"PKSA-qxvb-2bpp-dnk6",
					"PKSA-bbs6-q5q9-f3t4",
					"PKSA-bcdd-5xc7-gwfb",
					"PKSA-pwsk-hy21-4gby",
					"PKSA-93qv-9n9h-6k6p",
					"PKSA-k22t-f949-t9g6",
					"PKSA-d5tc-s1qs-h781",
					"PKSA-m5cs-t1y6-qpcs",
					"PKSA-3r5d-mb8f-1qw9",
					"PKSA-mdq4-51ck-6kdq"
				]
			}
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
