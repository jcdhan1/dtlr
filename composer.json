{
	"name": "jcdhan1/dtlr",
	"type": "project",
	"description": "Digital Techniques for Language Revival - Research project information, multilingual dictionary and machine translation UI.",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": "8.4.*",
		"guzzlehttp/guzzle": "^7.10",
		"laravel/framework": "11.55.*",
		"laravel/sanctum": "^4.3",
		"laravel/tinker": "^2.8",
		"spatie/laravel-db-snapshots": "^2.7",
		"toobo/bcp47": "^1"
	},
	"require-dev": {
		"fakerphp/faker": "^1.9.1",
		"laravel/breeze": "^2.4",
		"laravel/pint": "^1.0",
		"laravel/sail": "^1.18",
		"mockery/mockery": "^1.4.4",
		"nunomaduro/collision": "^8.5",
		"phpunit/phpunit": "^10.1",
		"spatie/laravel-ignition": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi"
		],
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi --force"
		],
		"post-root-package-install": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
		],
		"post-create-project-cmd": [
			"@php artisan key:generate --ansi"
		]
	},
	"extra": {
		"laravel": {
			"dont-discover": []
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		},
		"policy": {
			"advisories": {
				"ignore-id": {
					"PKSA-d5tc-s1qs-h781": {
						"on-audit": false,
						"reason": "Awaiting upgrade to laravel/framework:^12.61.1"
					},
					"PKSA-m5cs-t1y6-qpcs": {
						"on-audit": false,
						"reason": "Awaiting upgrade to laravel/framework:^12.61.1."
					},
					"PKSA-3r5d-mb8f-1qw9": {
						"on-audit": false,
						"reason": "Awaiting upgrade to laravel/framework:^12.61.1"
					},
					"PKSA-mdq4-51ck-6kdq": {
						"on-audit": false,
						"reason": "Awaiting upgrade to laravel/framework:^12.61.1"
					}
				}
			}
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
